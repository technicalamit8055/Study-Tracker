# Environment Variables for ExamRoadmap

# Port for local development
PORT=3005

# ---------------------------------------------------------------------------
# Supabase (authentication + cloud progress sync)
#
# Both values are PUBLIC and safe to expose to the browser: Row Level Security
# on the user_progress table is what protects student data, not key secrecy.
# Find them in: Supabase Dashboard -> Project Settings -> API
#
# SUPABASE_URL must be the bare project URL with no /rest/v1 suffix.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://iuokemxedggkbawkvqft.supabase.co
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Legacy custom-auth backend (optional)
#
# Supabase now handles auth and progress sync, so these are only needed if you
# still run the old /api/auth/* and /api/progress endpoints.
# ---------------------------------------------------------------------------
JWT_SECRET=
MONGODB_URI=
