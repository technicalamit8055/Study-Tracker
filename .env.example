# Environment Variables for Bihar STET 2026 Tracker

# Port for local development
PORT=3005

# Secret key for signing JWT student auth tokens
JWT_SECRET=stet_2026_super_secret_jwt_key_change_in_production

# MongoDB Atlas Connection String (Optional for local testing, Required on Vercel for persistent cloud sync)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stet_tracker?retryWrites=true&w=majority
MONGODB_URI=
